#!/bin/sh
# Append AI-Agent, AI-Model, Device, and Session trailers to every commit message.
#
# Never blocks a commit for missing or odd provenance: it stamps what is known.
# - AI_AGENT is normalised: claude-code_<ver>_agent -> claude, codex* -> codex,
#   gemini* -> gemini, grok-bot* -> grok-bot, grok* -> grok, gpt*/openai* -> chatgpt.
#   If AI_AGENT is unset, a few well-known CLI env markers are checked
#   (CLAUDECODE=1, GEMINI_CLI=1, CODEX_*, CURSOR_AGENT).
# - AI_DEVICE defaults from the hostname (3060ti, DESKTOP-5LUR71B -> 3080,
#   laptrade, SB -> surface); otherwise the lowercased hostname.
# - AI_MODEL defaults to a model env var the CLI exposes, else "unknown".
# - AI_SESSION defaults to the CLI's session id env var, else "unknown".
# - With no agent known at all (a plain human commit), only "Device:" is added,
#   so a human commit is never labeled as a model.
# - If the message already has an AI-Agent trailer, nothing is added.
# Values containing quotes, pipes, or chat-blob names are replaced, not rejected.

MSG_FILE="$1"
SOURCE="$2"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# Leave merge/squash messages and amended commits that already carry a stamp alone.
if grep -q '^AI-Agent:' "$MSG_FILE" 2>/dev/null; then
  exit 0
fi
[ "$SOURCE" = "merge" ] && exit 0

clean() {
  # strip CR/LF, quotes, pipes; collapse to a single safe token
  printf '%s' "$1" | tr -d "\r\n'\"|" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Join the existing trailer block (Co-Authored-By, Signed-off-by, ...) so GitHub still parses it.
# git interpret-trailers understands comment lines and the --verbose scissors; plain append is the fallback.
add_trailers() {
  for t in "$@"; do
    if ! git interpret-trailers --in-place --if-exists addIfDifferent --trailer "$t" "$MSG_FILE" 2>/dev/null; then
      printf '\n' >> "$MSG_FILE"
      for u in "$@"; do printf '%s\n' "$u" >> "$MSG_FILE"; done
      return 0
    fi
  done
}

AGENT_RAW=$(clean "${AI_AGENT:-}")
MODEL=$(clean "${AI_MODEL:-}")
DEVICE=$(clean "${AI_DEVICE:-}")
SESSION=$(clean "${AI_SESSION:-}")

# --- agent -----------------------------------------------------------------
if [ -z "$AGENT_RAW" ]; then
  if [ "${CLAUDECODE:-}" = "1" ]; then AGENT_RAW=claude
  elif [ -n "${GEMINI_CLI:-}" ]; then AGENT_RAW=gemini
  elif [ -n "${CODEX_SANDBOX:-}${CODEX_MANAGED_BY_NPM:-}${CODEX_HOME:-}" ]; then AGENT_RAW=codex
  elif [ -n "${CURSOR_AGENT:-}" ]; then AGENT_RAW=cursor
  fi
fi

AGENT=$(printf '%s' "$AGENT_RAW" | tr '[:upper:]' '[:lower:]')
case "$AGENT" in
  "") ;;
  grok-bot*|grokbot*) AGENT=grok-bot ;;
  grok*) AGENT=grok ;;
  claude*) AGENT=claude ;;          # claude, claude-code_2-1-287_agent, ...
  codex*) AGENT=codex ;;
  gemini*) AGENT=gemini ;;
  chatgpt*|gpt*|openai*) AGENT=chatgpt ;;
  cursor*) AGENT=cursor ;;
  human*) AGENT=human ;;
  *) AGENT=$(printf '%s' "$AGENT" | tr -c 'a-z0-9._-' '-' | cut -c1-40) ;;  # unknown: keep, sanitised
esac

# --- device ----------------------------------------------------------------
if [ -z "$DEVICE" ]; then
  HN=$(hostname 2>/dev/null || printf '%s' "${COMPUTERNAME:-${HOSTNAME:-}}")
  HN=$(clean "$HN")
  case "$(printf '%s' "$HN" | tr '[:upper:]' '[:lower:]')" in
    3060ti*) DEVICE=3060ti ;;
    desktop-5lur71b*) DEVICE=3080 ;;
    laptrade*) DEVICE=laptrade ;;
    sb|sb.*|sb-*|surface*) DEVICE=surface ;;
    "") DEVICE=unknown ;;
    *) DEVICE=$(printf '%s' "$HN" | tr '[:upper:]' '[:lower:]') ;;
  esac
else
  case "$(printf '%s' "$DEVICE" | tr '[:upper:]' '[:lower:]')" in
    desktop-5lur71b*) DEVICE=3080 ;;
    sb) DEVICE=surface ;;
  esac
fi

# Human commit with no agent known: stamp the device only.
if [ -z "$AGENT" ]; then
  add_trailers "Device: $DEVICE"
  exit 0
fi

# --- model -----------------------------------------------------------------
if [ -z "$MODEL" ]; then
  MODEL=$(clean "${ANTHROPIC_MODEL:-${CLAUDE_MODEL:-${GEMINI_MODEL:-${CODEX_MODEL:-${OPENAI_MODEL:-${GROK_MODEL:-}}}}}}")
  [ -n "$MODEL" ] || MODEL=unknown
fi

# --- session ---------------------------------------------------------------
if [ -z "$SESSION" ]; then
  SESSION=$(clean "${CLAUDE_CODE_SESSION_ID:-${GEMINI_SESSION_ID:-${CODEX_SESSION_ID:-}}}")
  [ -n "$SESSION" ] || SESSION=unknown
fi
case "$SESSION" in
  *blob*|*sand-client*|*gateway-descriptor*) SESSION=redacted ;;
esac

add_trailers "AI-Agent: $AGENT" "AI-Model: $MODEL" "Device: $DEVICE" "Session: $SESSION"
exit 0
